# העתק לקובץ .env לפיתוח מקומי, ובפרודקשן הגדר את אותם ערכים
# כמשתני סביבה ב-Render. הקובץ .env עצמו לא נכנס ל-git.

# חיבור למסד הנתונים
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/classwallet

# מפתח לחתימת עוגיית הסשן. חייב להיות אקראי ובאורך 32 תווים לפחות.
# יצירה:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# מפתח נפרד לאינדוקס סיסמאות המורים. אם לא מוגדר, נעשה שימוש ב-JWT_SECRET.
# שים לב: שינוי המפתח הזה מבטל את היכולת של מורים קיימים להתחבר.
LOOKUP_SECRET=

# מנהלי-על. הסיסמאות נשמרות כ-hash בלבד ולעולם לא בקוד.
# יצירת hash:  npm run hash -- "הסיסמה שלך"
SUPERADMIN_1_NAME=
SUPERADMIN_1_PASSWORD_HASH=

SUPERADMIN_2_NAME=
SUPERADMIN_2_PASSWORD_HASH=
